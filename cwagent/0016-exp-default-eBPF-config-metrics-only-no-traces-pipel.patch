From 1e7223a07fa52fc423fccba5323900f319644cb0 Mon Sep 17 00:00:00 2001
From: wangzlei <66336933+wangzlei@users.noreply.github.com>
Date: Fri, 23 Oct 2026 22:19:27 +0000
Subject: [PATCH] exp: default eBPF config: metrics only, no traces pipeline

Every instrument entry exports metrics, so OBI built no spans and the
traces pipeline to X-Ray was always idle.
---
 .../amazon-cloudwatch-agent-ebpf.yaml         | 35 ++-----------------
 1 file changed, 2 insertions(+), 33 deletions(-)

diff --git a/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml b/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
index 5c595db0..57e890cb 100644
--- a/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
+++ b/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
@@ -16,7 +16,7 @@
 #   amazon-cloudwatch-agent-ctl -a disable-ebpf
 # Source: adot-obi config/otel.yaml.
 #
-#   AWS_REGION      X-Ray / CloudWatch region          (default us-west-2)
+#   AWS_REGION      CloudWatch region                  (default us-west-2)
 #   AWS_VPC_ID, AWS_SUBNET_ID  optional resource attributes (skipped when unset)
 #
 # Never use a double dollar sign in this file: cwagent expands it a second time
@@ -93,9 +93,6 @@ receivers:
       enabled: false
 
 extensions:
-  sigv4auth/xray:
-    region: ${env:AWS_REGION:-us-west-2}
-    service: xray
   sigv4auth/monitoring:
     region: ${env:AWS_REGION:-us-west-2}
     service: monitoring
@@ -106,26 +103,6 @@ processors:
   # VPC / subnet come in as AWS_VPC_ID / AWS_SUBNET_ID env and are skipped when unset.
   transform/aws:
     error_mode: ignore
-    trace_statements:
-      - context: resource
-        statements:
-          - set(attributes["ec2.instance.id"], attributes["host.id"]) where attributes["host.id"] != nil
-          - set(attributes["aws.account.id"], attributes["cloud.account.id"]) where attributes["cloud.account.id"] != nil
-          - set(attributes["aws.region"], attributes["cloud.region"]) where attributes["cloud.region"] != nil
-          - set(attributes["host.ip"], attributes["host.name"]) where attributes["host.name"] != nil and IsMatch(attributes["host.name"], "^ip-[0-9]+-[0-9]+-[0-9]+-[0-9]+")
-          - replace_pattern(attributes["host.ip"], "[.].*", "") where attributes["host.ip"] != nil
-          - replace_pattern(attributes["host.ip"], "^ip-", "") where attributes["host.ip"] != nil
-          - replace_pattern(attributes["host.ip"], "-", ".") where attributes["host.ip"] != nil
-          - set(attributes["aws.vpc.id"], "${env:AWS_VPC_ID}") where "${env:AWS_VPC_ID}" != ""
-          - set(attributes["aws.subnet.id"], "${env:AWS_SUBNET_ID}") where "${env:AWS_SUBNET_ID}" != ""
-      # Lambda Invoke by bare function name: OBI cannot know the account, so complete
-      # aws.lambda.function.arn from the host's cloud.account.id (the caller's account
-      # unless it uses cross-account credentials) + faas.invoked_region / _name.
-      - context: span
-        statements:
-          - set(attributes["aws.lambda.function.arn"], Concat(["arn:aws:lambda:", attributes["faas.invoked_region"], ":", resource.attributes["cloud.account.id"], ":function:", attributes["faas.invoked_name"]], "")) where attributes["aws.lambda.function.arn"] == nil and attributes["faas.invoked_name"] != nil and attributes["faas.invoked_region"] != nil and resource.attributes["cloud.account.id"] != nil
-          - replace_pattern(attributes["aws.lambda.function.arn"], "^arn:aws:lambda:cn-", "arn:aws-cn:lambda:cn-") where attributes["aws.lambda.function.arn"] != nil
-          - replace_pattern(attributes["aws.lambda.function.arn"], "^arn:aws:lambda:us-gov-", "arn:aws-us-gov:lambda:us-gov-") where attributes["aws.lambda.function.arn"] != nil
     metric_statements:
       - context: resource
         statements:
@@ -156,27 +133,19 @@ processors:
 
 exporters:
   # otlp_http compresses with gzip by default.
-  otlp_http/xray:
-    traces_endpoint: https://xray.${env:AWS_REGION:-us-west-2}.amazonaws.com/v1/traces
-    auth:
-      authenticator: sigv4auth/xray
   otlp_http/cloudwatch:
     metrics_endpoint: https://monitoring.${env:AWS_REGION:-us-west-2}.amazonaws.com/v1/metrics
     auth:
       authenticator: sigv4auth/monitoring
 
 service:
-  extensions: [sigv4auth/xray, sigv4auth/monitoring]
+  extensions: [sigv4auth/monitoring]
   telemetry:
     logs:
       level: info
     metrics:
       level: none
   pipelines:
-    traces:
-      receivers: [obi]
-      processors: [transform/aws, batch]
-      exporters: [otlp_http/xray]
     metrics:
       receivers: [obi]
       processors: [transform/aws, cumulativetodelta, batch]
-- 
2.50.1

