From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wangzlei <66336933+wangzlei@users.noreply.github.com>
Date: Fri, 9 Oct 2026 19:48:05 -0700
Subject: [PATCH 6/9] exp: default eBPF config: high_request_volume false

true dropped ~31% of server spans for requests whose downstream calls were slow
or timed out (ping demo with packet loss: 81 of 118 checkout requests in RED);
false (OBI's default) matched the access log (127 vs 124).
---
 packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml b/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
index 9f39efa8..d906cffa 100644
--- a/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
+++ b/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
@@ -26,7 +26,10 @@ receivers:
       bpf_fs_base_dir: /sys/fs/bpf
       # Pinned: cwagent's obi receiver defaults to "tcp".
       context_propagation: "all"
-      high_request_volume: true
+      # false (OBI's default): a server request ends when its response is complete.
+      # true submits it at the first response write, which dropped ~31% of
+      # requests whose downstream calls were slow or timed out (ping demo, 2026-10-09).
+      high_request_volume: false
       # AWS SDK spans: the upstream S3/SQS parsers need the large HTTP buffer.
       buffer_sizes:
         http: 8192
