From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wangzlei <66336933+wangzlei@users.noreply.github.com>
Date: Fri, 9 Oct 2026 15:01:32 -0700
Subject: [PATCH 4/9] exp: ebpf drop-in adds CAP_SYS_ADMIN for the FIONREAD
 compensation

On kernels with commit 929e30f93125 (6.6.128+, 6.12.75+, 6.18.14+, 6.19+)
OBI's TCP context propagation loads a FIONREAD compensation program that
uses bpf_probe_write_user, which needs CAP_SYS_ADMIN. Without it the agent
logs 'context propagation is disabled'.
---
 .../dependencies/amazon-cloudwatch-agent-ebpf.conf  | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/packaging/dependencies/amazon-cloudwatch-agent-ebpf.conf b/packaging/dependencies/amazon-cloudwatch-agent-ebpf.conf
index 221eb446..39fa6f08 100644
--- a/packaging/dependencies/amazon-cloudwatch-agent-ebpf.conf
+++ b/packaging/dependencies/amazon-cloudwatch-agent-ebpf.conf
@@ -2,13 +2,18 @@
 #   /etc/systemd/system/amazon-cloudwatch-agent.service.d/ebpf.conf
 # Runs the agent as the unprivileged cwagent user with only the capabilities the
 # ADOT OBI eBPF receiver needs (raised as ambient, so they survive the exec of the
-# agent binary). No CAP_SYS_ADMIN. start-amazon-cloudwatch-agent skips its own
-# run_as_user switch when it is not started as root.
+# agent binary). start-amazon-cloudwatch-agent skips its own run_as_user switch
+# when it is not started as root.
+# CAP_SYS_ADMIN is required for TCP context propagation on kernels with commit
+# 929e30f93125 (6.6.128+, 6.12.75+, 6.18.14+, 6.19+): there OBI loads a FIONREAD
+# compensation BPF program that uses bpf_probe_write_user, which the verifier only
+# allows with CAP_SYS_ADMIN. Without it propagation is disabled (RED still works,
+# no peer.service.name).
 [Service]
 User=cwagent
 Group=cwagent
-AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_CHECKPOINT_RESTORE CAP_NET_RAW CAP_NET_ADMIN
-CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_CHECKPOINT_RESTORE CAP_NET_RAW CAP_NET_ADMIN
+AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_CHECKPOINT_RESTORE CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_ADMIN
+CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_CHECKPOINT_RESTORE CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_ADMIN
 LimitMEMLOCK=infinity
 # The agent writes logs/ and var/ and reads etc/ (written by the ctl as root).
 # "+" runs this one step as root.
