From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wangzlei <66336933+wangzlei@users.noreply.github.com>
Date: Mon, 12 Oct 2026 15:52:13 -0700
Subject: [PATCH 8/9] exp: default eBPF config: unified EC2/ECS/EKS discovery

Instrument common service ports (80,443,3000,5000,8000-8099,8443,8888,9000)
plus every Deployment/StatefulSet pod on EKS. Exclude the agent itself and
other agents/proxies by exe path, AWS system namespaces, DaemonSet pods,
EKS add-on pods and pods annotated cloudwatch.aws/ebpf-instrument=false
(placeholder key). The excludes are added to OBI's built-in ones.
k8s_* selectors never match without Kubernetes metadata (EC2/ECS).
---
 .../amazon-cloudwatch-agent-ebpf.yaml         | 30 +++++++++++++++++--
 1 file changed, 27 insertions(+), 3 deletions(-)

diff --git a/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml b/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
index 6a66f090..ddcae522 100644
--- a/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
+++ b/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
@@ -39,11 +39,35 @@ receivers:
         http:
           aws:
             enabled: true
+    # One filter for EC2, ECS and EKS. Within an entry all keys must match (AND);
+    # a process is picked when any instrument entry matches (OR) and no
+    # exclude_instrument entry does (exclude wins). k8s_* keys never match a process
+    # without Kubernetes metadata, so those entries are inert on EC2 / ECS.
     discovery:
       instrument:
-        # ping: 8000; eks-auto apps: 8080-8083, 8443. Not an env var: a single-port
-        # value would be typed as an int and rejected by OBI.
-        - open_ports: "8000,8080,8081,8082,8083,8443"
+        # EC2 / ECS: common service ports (ping: 8000; eks-auto: 8080-8083, 8443).
+        # OBI matches every local inet port of a process, not only listeners, so keep
+        # ranges below the ephemeral range (32768-60999). Not an env var: a
+        # single-port value would be typed as an int and rejected by OBI.
+        - open_ports: "80,443,3000,5000,8000-8099,8443,8888,9000"
+        # EKS: every Deployment / StatefulSet pod, whatever its ports.
+        - k8s_deployment_name: "*"
+        - k8s_statefulset_name: "*"
+      # Added to OBI's built-in excludes (obi / otelcol* executables and the
+      # kube-system, kube-node-lease, cert-manager, monitoring, ... namespaces).
+      exclude_instrument:
+        # Self and other agents/proxies. OBI's built-ins do not cover cwagent.
+        - exe_path: "{*/amazon-cloudwatch-agent*,*/envoy*,*otelcol*,*/aws-otel-collector*}"
+        - k8s_namespace: "{amazon-cloudwatch,amazon-guardduty,aws-observability,karpenter,kube-public}"
+        # Node agents: also stops the port rule from picking up DaemonSet pods.
+        - k8s_daemonset_name: "*"
+        # EKS add-ons.
+        - k8s_pod_labels:
+            eks.amazonaws.com/component: "*"
+        # Per-pod opt-out. PLACEHOLDER key: align with the CloudWatch Agent's
+        # annotation convention before shipping.
+        - k8s_pod_annotations:
+            cloudwatch.aws/ebpf-instrument: "false"
     attributes:
       kubernetes:
         # On in EKS, off on plain EC2 ("true" would fail without a cluster).
