From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wangzlei <66336933+wangzlei@users.noreply.github.com>
Date: Thu, 22 Oct 2026 20:39:54 +0000
Subject: [PATCH] exp: default eBPF config: maps_config.global_scale_factor -1

Halve every resizable BPF map to save kernel memory (OBI scales map sizes
by 2^global_scale_factor, -3..3; 0 = upstream sizes).
---
 packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml b/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
index 3832974f..10f80887 100644
--- a/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
+++ b/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
@@ -42,6 +42,10 @@ receivers:
         http:
           aws:
             enabled: true
+      # Halve every resizable BPF map (OBI scales sizes by 2^factor, -3..3) to
+      # save kernel memory; 0 = upstream sizes.
+      maps_config:
+        global_scale_factor: -1
     # One filter for EC2, ECS and EKS. Within an entry all keys must match (AND);
     # a process is picked when any instrument entry matches (OR) and no
     # exclude_instrument entry does (exclude wins). k8s_* keys never match a process
-- 
2.50.1

