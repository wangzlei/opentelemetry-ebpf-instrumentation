From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wangzlei <66336933+wangzlei@users.noreply.github.com>
Date: Mon, 12 Oct 2026 16:24:19 -0700
Subject: [PATCH 9/9] exp: default eBPF config: service name from project
 metadata / command line

Enables discovery.service_name_from_cmdline (adot-obi patch 05-autoname): a
process without OTEL_SERVICE_NAME is named from its package.json,
pyproject.toml, JAR / main class or script instead of python3 / node / java,
and that name is what callers see as peer.service.name. Kubernetes names still
win. Set it to false for OBI's upstream executable-name naming.
---
 packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml b/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
index ddcae522..a29c801f 100644
--- a/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
+++ b/packaging/dependencies/amazon-cloudwatch-agent-ebpf.yaml
@@ -44,6 +44,10 @@ receivers:
     # exclude_instrument entry does (exclude wins). k8s_* keys never match a process
     # without Kubernetes metadata, so those entries are inert on EC2 / ECS.
     discovery:
+      # A process without OTEL_SERVICE_NAME is named from its package.json /
+      # pyproject.toml / JAR / main class / script instead of python3, node,
+      # java; Kubernetes names still win. false = upstream (executable) naming.
+      service_name_from_cmdline: true
       instrument:
         # EC2 / ECS: common service ports (ping: 8000; eks-auto: 8080-8083, 8443).
         # OBI matches every local inet port of a process, not only listeners, so keep
