index 0000000000000000000000000000000000000000..74589983d093388ef66ca97cca4af95cce01f7c5
--- /dev/null
+++ b/pkg/internal/procname/procname.go
@@ -0,0 +1,409 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+// Package procname derives a service name for an interpreted process
+// (Python, Node.js, .NET, Ruby, PHP) from its project metadata or its command
+// line, for processes that set neither OTEL_SERVICE_NAME nor service.name in
+// OTEL_RESOURCE_ATTRIBUTES. Without it, every such process is named after its
+// interpreter (python3, node, dotnet, ...).
+//
+// Enabled by discovery.service_name_from_cmdline. The name is stored as an
+// automatic name, so Kubernetes metadata still overrides it. Java has its own
+// resolver in pkg/internal/jvmtools, which uses Clean from this package.
+package procname // import "go.opentelemetry.io/obi/pkg/internal/procname"
+
+import (
+	"encoding/json"
+	"path"
+	"regexp"
+	"strings"
+)
+
+// MaxLen caps a derived name (a DNS label is at most 63 characters).
+const MaxLen = 63
+
+// maxFileBytes bounds the project files read from a process (package.json,
+// pyproject.toml).
+const maxFileBytes = 1 << 20
+
+// genericNames carry no service identity; a derived name equal to one of them
+// (case-insensitive) is discarded so the executable-name fallback is kept.
+var genericNames = map[string]struct{}{}
+
+func init() {
+	for _, n := range []string{
+		"main", "app", "index", "server", "run", "start", "wsgi", "asgi", "manage",
+		"application", "dist", "src", "bin", "lib", "build",
+	} {
+		genericNames[n] = struct{}{}
+	}
+}
+
+// GenericNames returns the names that are never used as a derived name.
+func GenericNames() []string {
+	out := make([]string, 0, len(genericNames))
+	for n := range genericNames {
+		out = append(out, n)
+	}
+	return out
+}
+
+// IsGeneric reports whether name carries no service identity.
+func IsGeneric(name string) bool {
+	_, ok := genericNames[strings.ToLower(name)]
+	return ok
+}
+
+var versionSuffix = regexp.MustCompile(`-\d+(\.\d+)*(-SNAPSHOT)?$`)
+
+// Clean turns a raw candidate into a service name: characters outside
+// [A-Za-z0-9._-] become '-', a trailing version (-1.4.2, -1.4.2-SNAPSHOT) is
+// removed, leading and trailing separators are trimmed and the result is capped
+// at MaxLen. It returns "" when nothing meaningful is left (empty or generic).
+func Clean(name string) string {
+	b := []byte(name)
+	for i, c := range b {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '.' || c == '_' || c == '-') {
+			b[i] = '-'
+		}
+	}
+	name = versionSuffix.ReplaceAllString(string(b), "")
+	name = strings.Trim(name, "-._")
+	if len(name) > MaxLen {
+		name = strings.TrimRight(name[:MaxLen], "-._")
+	}
+	if name == "" || IsGeneric(name) {
+		return ""
+	}
+	return name
+}
+
+// Process is the input of Derive. Paths are as seen by the process (its mount
+// namespace); ReadFile resolves them inside the process root.
+type Process struct {
+	// Exe is the basename of the executable (/proc/<pid>/exe), e.g. python3.12.
+	Exe string
+	// Argv is the full command line, Argv[0] included.
+	Argv []string
+	// Cwd is the working directory of the process.
+	Cwd string
+	// ReadFile reads an absolute path inside the process root. May be nil.
+	ReadFile func(path string) ([]byte, error)
+}
+
+var (
+	pythonExe = regexp.MustCompile(`^python(\d+(\.\d+)?)?[a-z]?$`)
+	nodeExe   = regexp.MustCompile(`^(node|nodejs)$`)
+	rubyExe   = regexp.MustCompile(`^ruby(\d+(\.\d+)*)?$`)
+	phpExe    = regexp.MustCompile(`^php(\d+(\.\d+)*)?$`)
+)
+
+// Derive returns a service name for p, or "" when the executable is not a
+// known interpreter or nothing better than the executable name was found.
+// Project metadata wins over the command line.
+func Derive(p Process) string {
+	argv := p.Argv
+	// setproctitle (gunicorn: "gunicorn: worker [server:app]") rewrites the
+	// command line as one space-separated string.
+	if len(argv) == 1 && strings.ContainsRune(argv[0], ' ') {
+		argv = strings.Fields(argv[0])
+	}
+	if len(argv) == 0 {
+		return ""
+	}
+	args := argv[1:]
+	switch {
+	case pythonExe.MatchString(p.Exe):
+		if n := pyprojectName(p); n != "" {
+			return n
+		}
+		if w := pythonWrapper(path.Base(strings.TrimSuffix(argv[0], ":"))); w != "" {
+			return fromPythonWrapper(w, args)
+		}
+		return fromPython(args)
+	case nodeExe.MatchString(p.Exe):
+		return fromNode(p, args)
+	case p.Exe == "dotnet":
+		return fromDotnet(args)
+	case rubyExe.MatchString(p.Exe):
+		return Clean(trimExt(path.Base(firstScript(args, rubyValueOpts, rubyStopOpts)), ".rb"))
+	case phpExe.MatchString(p.Exe):
+		return Clean(trimExt(path.Base(firstScript(args, phpValueOpts, phpStopOpts)), ".php"))
+	}
+	return ""
+}
+
+func trimExt(name string, exts ...string) string {
+	for _, e := range exts {
+		if strings.HasSuffix(name, e) {
+			return strings.TrimSuffix(name, e)
+		}
+	}
+	return name
+}
+
+// firstScript returns the first non-option argument, skipping the values of
+// the options in valueOpts; it returns "" at any option in stopOpts (inline
+// code, interactive mode, ...).
+func firstScript(args []string, valueOpts, stopOpts map[string]bool) string {
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		switch {
+		case stopOpts[a]:
+			return ""
+		case a == "--":
+			if i+1 < len(args) {
+				return args[i+1]
+			}
+			return ""
+		case valueOpts[a]:
+			i++
+		case a == "-":
+			return ""
+		case strings.HasPrefix(a, "-"):
+		default:
+			return a
+		}
+	}
+	return ""
+}
+
+func set(s ...string) map[string]bool {
+	m := make(map[string]bool, len(s))
+	for _, v := range s {
+		m[v] = true
+	}
+	return m
+}
+
+// ---------- Python ----------
+
+var (
+	pyValueOpts = set("-X", "-W", "--check-hash-based-pycs")
+	pyStopOpts  = set("-c", "-i")
+	// wrappers that serve a WSGI/ASGI (or Celery) application given as a target.
+	pyWrappers = set("gunicorn", "uvicorn", "hypercorn", "waitress", "waitress-serve", "celery", "daphne")
+	// module:attr, e.g. orders.main:app or app:create_app()
+	appTarget = regexp.MustCompile(`^([A-Za-z_][A-Za-z0-9_.]*):[A-Za-z_][A-Za-z0-9_.]*(\(.*\))?$`)
+)
+
+func pythonWrapper(name string) string {
+	if pyWrappers[name] {
+		return name
+	}
+	return ""
+}
+
+func fromPython(args []string) string {
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		switch {
+		case pyStopOpts[a] || a == "-":
+			return ""
+		case a == "-m" || (strings.HasPrefix(a, "-m") && len(a) > 2 && !strings.HasPrefix(a, "--")):
+			mod := strings.TrimPrefix(a, "-m")
+			rest := args[i+1:]
+			if mod == "" {
+				if len(rest) == 0 {
+					return ""
+				}
+				mod, rest = rest[0], rest[1:]
+			}
+			if w := pythonWrapper(strings.SplitN(mod, ".", 2)[0]); w != "" {
+				return fromPythonWrapper(w, rest)
+			}
+			return dotted(mod)
+		case pyValueOpts[a]:
+			i++
+		case strings.HasPrefix(a, "-"):
+		default:
+			base := trimExt(path.Base(a), ".py", ".pyw", ".pyc", ".pyz")
+			if w := pythonWrapper(base); w != "" {
+				return fromPythonWrapper(w, args[i+1:])
+			}
+			return Clean(base)
+		}
+	}
+	return ""
+}
+
+// dotted returns the last non-generic component of a dotted module path:
+// orders.main -> orders, billing.worker -> worker.
+func dotted(mod string) string {
+	parts := strings.Split(mod, ".")
+	for i := len(parts) - 1; i >= 0; i-- {
+		if n := Clean(parts[i]); n != "" {
+			return n
+		}
+	}
+	return ""
+}
+
+func fromPythonWrapper(wrapper string, args []string) string {
+	if wrapper == "celery" {
+		for i := 0; i < len(args); i++ {
+			a := args[i]
+			switch {
+			case (a == "-A" || a == "--app") && i+1 < len(args):
+				return dotted(strings.SplitN(args[i+1], ":", 2)[0])
+			case strings.HasPrefix(a, "--app="):
+				return dotted(strings.SplitN(strings.TrimPrefix(a, "--app="), ":", 2)[0])
+			case strings.HasPrefix(a, "-A") && len(a) > 2:
+				return dotted(strings.SplitN(a[2:], ":", 2)[0])
+			}
+		}
+		return ""
+	}
+	// The application target is the last module:attr argument; option values
+	// such as -b :8000 or -b 0.0.0.0:8000 do not match the pattern.
+	for i := len(args) - 1; i >= 0; i-- {
+		a := strings.Trim(args[i], "[]")
+		if m := appTarget.FindStringSubmatch(a); m != nil {
+			return dotted(m[1])
+		}
+	}
+	return ""
+}
+
+// pyprojectName reads [project].name (or [tool.poetry].name) from
+// pyproject.toml in the working directory.
+func pyprojectName(p Process) string {
+	if p.ReadFile == nil || p.Cwd == "" {
+		return ""
+	}
+	data, err := p.ReadFile(path.Join(p.Cwd, "pyproject.toml"))
+	if err != nil || len(data) > maxFileBytes {
+		return ""
+	}
+	inTable := false
+	for _, line := range strings.Split(string(data), "\n") {
+		line = strings.TrimSpace(line)
+		if strings.HasPrefix(line, "[") {
+			t := strings.TrimSpace(strings.Trim(line, "[]"))
+			inTable = t == "project" || t == "tool.poetry"
+			continue
+		}
+		if !inTable {
+			continue
+		}
+		k, v, ok := strings.Cut(line, "=")
+		if !ok || strings.TrimSpace(k) != "name" {
+			continue
+		}
+		v = strings.TrimSpace(v)
+		if len(v) >= 2 && (v[0] == '"' || v[0] == '\'') {
+			if end := strings.IndexByte(v[1:], v[0]); end >= 0 {
+				return Clean(v[1 : end+1])
+			}
+		}
+		return ""
+	}
+	return ""
+}
+
+// ---------- Node.js ----------
+
+var (
+	nodeValueOpts = set("-r", "--require", "--import", "--loader", "--experimental-loader",
+		"--env-file", "--title", "--input-type", "--conditions", "-C", "--watch-path",
+		"--inspect-port", "--debug-port", "--max-http-header-size", "--stack-size",
+		"--max-old-space-size", "--openssl-config", "--icu-data-dir", "--disable-warning")
+	nodeStopOpts = set("-e", "--eval", "-p", "--print", "-i", "--interactive", "-c", "--check",
+		"--test", "-v", "--version", "-h", "--help")
+)
+
+func fromNode(p Process, args []string) string {
+	script := firstScript(args, nodeValueOpts, nodeStopOpts)
+	if script == "" {
+		return ""
+	}
+	if n := packageJSONName(p, script); n != "" {
+		return n
+	}
+	if strings.Contains(script, "node_modules/") {
+		// a tool started from node_modules (npm, next, ts-node, ...): its file
+		// name is not the service; only the project's package.json is.
+		return ""
+	}
+	return Clean(trimExt(path.Base(script), ".js", ".mjs", ".cjs", ".ts"))
+}
+
+// packageJSONName returns the npm package name (scope removed) of the nearest
+// package.json, searched from the script's directory up to the working
+// directory. For a script under node_modules only the working directory is
+// searched, so npm's own package.json is never used.
+func packageJSONName(p Process, script string) string {
+	if p.ReadFile == nil {
+		return ""
+	}
+	abs := script
+	if !path.IsAbs(abs) {
+		if p.Cwd == "" {
+			return ""
+		}
+		abs = path.Join(p.Cwd, abs)
+	}
+	var dirs []string
+	if strings.Contains(abs, "/node_modules/") {
+		if p.Cwd != "" {
+			dirs = []string{p.Cwd}
+		}
+	} else {
+		dir := path.Dir(abs)
+		if script == "." || strings.HasSuffix(script, "/") {
+			dir = abs // node <dir>: the directory itself is the package
+		}
+		for i := 0; i < 6 && dir != "/" && dir != "."; i++ {
+			dirs = append(dirs, dir)
+			if dir == p.Cwd {
+				break
+			}
+			dir = path.Dir(dir)
+		}
+	}
+	for _, d := range dirs {
+		data, err := p.ReadFile(path.Join(d, "package.json"))
+		if err != nil || len(data) > maxFileBytes {
+			continue
+		}
+		var pkg struct {
+			Name string `json:"name"`
+		}
+		if json.Unmarshal(data, &pkg) != nil || pkg.Name == "" {
+			continue
+		}
+		name := pkg.Name
+		if strings.HasPrefix(name, "@") {
+			if _, after, ok := strings.Cut(name, "/"); ok {
+				name = after
+			}
+		}
+		return Clean(name)
+	}
+	return ""
+}
+
+// ---------- .NET, Ruby, PHP ----------
+
+var (
+	dotnetValueOpts = set("--runtimeconfig", "--depsfile", "--additionalprobingpath",
+		"--additional-deps", "--fx-version", "--roll-forward")
+	rubyValueOpts = set("-I", "-r", "-C", "-E", "--encoding", "-x")
+	rubyStopOpts  = set("-e", "-v", "--version", "-h", "--help")
+	phpValueOpts  = set("-c", "-d", "-t", "-z")
+	phpStopOpts   = set("-r", "-S", "-a", "-i", "-v", "-h", "-m")
+)
+
+// fromDotnet handles "dotnet [exec] [host options] X.dll": the assembly name.
+func fromDotnet(args []string) string {
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		switch {
+		case dotnetValueOpts[a]:
+			i++
+		case strings.HasSuffix(strings.ToLower(a), ".dll"):
+			return Clean(a[strings.LastIndexByte(a, '/')+1 : len(a)-len(".dll")])
+		}
+	}
+	return ""
+}
diff --git a/pkg/internal/procname/procname_test.go b/pkg/internal/procname/procname_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d484afe9b6391ff32a2c74aba6c4a3ab445ee430
--- /dev/null
+++ b/pkg/internal/procname/procname_test.go
@@ -0,0 +1,161 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package procname
+
+import (
+	"errors"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+
+	"go.opentelemetry.io/obi/pkg/appolly/app"
+	"go.opentelemetry.io/obi/pkg/appolly/app/svc"
+	"go.opentelemetry.io/obi/pkg/appolly/discover/exec"
+)
+
+// fakeFS maps absolute in-process paths to file contents.
+type fakeFS map[string]string
+
+func (f fakeFS) read(p string) ([]byte, error) {
+	if s, ok := f[p]; ok {
+		return []byte(s), nil
+	}
+	return nil, os.ErrNotExist
+}
+
+// effectiveName is what OBI ends up with: the derived name, else the
+// executable-name fallback of exec.FileInfo.ApplyServiceDefaults.
+func effectiveName(p Process) string {
+	if n := Derive(p); n != "" {
+		return n
+	}
+	return p.Exe
+}
+
+func TestDerive(t *testing.T) {
+	tests := []struct {
+		name string
+		exe  string
+		cmd  string // space-separated argv
+		cwd  string
+		fs   fakeFS
+		want string
+	}{
+		// Python
+		{"gunicorn server:app is generic", "python3.12", "python3.12 /usr/local/bin/gunicorn -w 2 -b :8000 server:app", "/srv", nil, "python3.12"},
+		{"uvicorn orders.main:app -> first non-generic module component", "python3", "python -m uvicorn orders.main:app", "/srv", nil, "orders"},
+		{"manage.py runserver is generic", "python3", "python manage.py runserver", "/srv", nil, "python3"},
+		{"plain script", "python3", "python /srv/billing_worker.py", "/", nil, "billing_worker"},
+		{"-m module", "python3", "python3 -u -m billing.worker", "/", nil, "worker"},
+		{"-m module with generic last component", "python3", "python3 -m billing.__main__", "/", nil, "billing"},
+		{"gunicorn bind with host:port is not the target", "python3", "python3 /usr/local/bin/gunicorn -b 0.0.0.0:8000 payments.wsgi:application", "/", nil, "payments"},
+		{"gunicorn setproctitle", "python3.12", "gunicorn: worker [inventory:app]", "/", nil, "inventory"},
+		{"celery -A", "python3", "python3 /usr/local/bin/celery -A tasks.celery_app worker", "/", nil, "celery_app"},
+		{"daphne asgi", "python3", "python3 /usr/local/bin/daphne -b 0.0.0.0 shop.asgi:application", "/", nil, "shop"},
+		{"python -c stays fallback", "python3", "python3 -c print(1)", "/", nil, "python3"},
+		{"pyproject wins over script", "python3", "python3 main.py", "/srv/app", fakeFS{"/srv/app/pyproject.toml": "[build-system]\nname = \"x\"\n[project]\nname = \"ledger-api\"\nversion = \"1.0\"\n"}, "ledger-api"},
+		{"script version stripped", "python3", "python3 /srv/report-gen-2.1.py", "/", nil, "report-gen"},
+
+		// Node.js
+		{"node server.js is generic", "node", "node server.js", "/srv", nil, "node"},
+		{"package.json name with npm scope", "node", "node dist/index.js", "/srv/orders", fakeFS{"/srv/orders/package.json": `{"name":"@acme/orders-api","version":"1.0.0"}`}, "orders-api"},
+		{"package.json next to the script", "node", "node /opt/svc/lib/main.js", "/", fakeFS{"/opt/svc/lib/package.json": `{"name":"svc-worker"}`}, "svc-worker"},
+		{"node options skipped", "node", "node --require ./otel.js -r dotenv/config --inspect=0.0.0.0:9229 checkout.mjs", "/srv", nil, "checkout"},
+		{"npm start uses cwd package.json", "node", "node /usr/local/lib/node_modules/npm/bin/npm-cli.js start", "/srv/cart", fakeFS{"/srv/cart/package.json": `{"name":"cart"}`, "/usr/local/lib/node_modules/npm/package.json": `{"name":"npm"}`}, "cart"},
+		{"tool under node_modules without package.json", "node", "node node_modules/.bin/next start", "/srv", nil, "node"},
+		{"node -e stays fallback", "node", "node -e 1", "/", nil, "node"},
+
+		// .NET, Ruby, PHP
+		{"dotnet assembly", "dotnet", "dotnet Orders.Api.dll", "/app", nil, "Orders.Api"},
+		{"dotnet exec with host option", "dotnet", "dotnet exec --runtimeconfig x.json /app/Billing.dll", "/app", nil, "Billing"},
+		{"ruby script", "ruby", "ruby -I lib /srv/notifier.rb", "/", nil, "notifier"},
+		{"php script", "php8.2", "php -d memory_limit=1G worker.php", "/", nil, "worker"},
+
+		// Native and unknown executables keep the executable name.
+		{"native binary", "ping-app", "/ping-app", "/", nil, "ping-app"},
+		{"native binary with args", "envoy", "envoy -c /etc/envoy.yaml", "/", nil, "envoy"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			p := Process{Exe: tt.exe, Argv: strings.Fields(tt.cmd), Cwd: tt.cwd}
+			if strings.HasPrefix(tt.cmd, "gunicorn: ") {
+				p.Argv = []string{tt.cmd} // setproctitle: one NUL-free string
+			}
+			if tt.fs != nil {
+				p.ReadFile = tt.fs.read
+			}
+			assert.Equal(t, tt.want, effectiveName(p), "cmdline %q", tt.cmd)
+		})
+	}
+}
+
+func TestClean(t *testing.T) {
+	for in, want := range map[string]string{
+		"order-service-1.4.2":          "order-service",
+		"order-service-1.4.2-SNAPSHOT": "order-service",
+		"orders api":                   "orders-api",
+		"Main":                         "",
+		"APPLICATION":                  "",
+		"__main__":                     "",
+		"":                             "",
+		"1.2.3":                        "1.2.3",
+		strings.Repeat("a", 70):        strings.Repeat("a", MaxLen),
+	} {
+		assert.Equal(t, want, Clean(in), "Clean(%q)", in)
+	}
+}
+
+func mockProc(t *testing.T, argv []string, cwd string, fs fakeFS) {
+	t.Helper()
+	oldCmd, oldCwd, oldRoot, oldRead := cmdlineForPID, cwdForPID, rootDirForPID, readFileInRoot
+	cmdlineForPID = func(app.PID) (string, []string, error) {
+		if len(argv) == 0 {
+			return "", nil, errors.New("gone")
+		}
+		return argv[0], argv[1:], nil
+	}
+	cwdForPID = func(app.PID) (string, error) { return cwd, nil }
+	rootDirForPID = func(app.PID) string { return "/proc/1/root" }
+	readFileInRoot = func(_, p string) ([]byte, error) { return fs.read(p) }
+	t.Cleanup(func() { cmdlineForPID, cwdForPID, rootDirForPID, readFileInRoot = oldCmd, oldCwd, oldRoot, oldRead })
+}
+
+func TestResolve(t *testing.T) {
+	mockProc(t, []string{"node", "index.js"}, "/srv/backend", fakeFS{"/srv/backend/package.json": `{"name":"orders-backend"}`})
+
+	fi := exec.New(exec.Init{Pid: 42, CmdExePath: "/usr/bin/node"})
+	assert.Equal(t, "orders-backend", Resolve(fi))
+	attrs := fi.ServiceAttrs()
+	assert.Equal(t, "orders-backend", attrs.UID.Name)
+	assert.True(t, attrs.AutoName(), "derived name must stay overridable by Kubernetes metadata")
+}
+
+func TestResolveKeepsEnvName(t *testing.T) {
+	mockProc(t, []string{"node", "index.js"}, "/srv/backend", fakeFS{"/srv/backend/package.json": `{"name":"orders-backend"}`})
+
+	fi := exec.New(exec.Init{Pid: 42, CmdExePath: "/usr/bin/node"})
+	fi.ApplyEnvVariables(map[string]string{"OTEL_SERVICE_NAME": "checkout"})
+	assert.Empty(t, Resolve(fi))
+	assert.Equal(t, "checkout", fi.ServiceAttrs().UID.Name)
+
+	fi = exec.New(exec.Init{Pid: 43, CmdExePath: "/usr/bin/node"})
+	fi.ApplyEnvVariables(map[string]string{"OTEL_RESOURCE_ATTRIBUTES": "service.name=cart,deployment.environment=prod"})
+	assert.Empty(t, Resolve(fi))
+	assert.Equal(t, "cart", fi.ServiceAttrs().UID.Name)
+
+	// a name from the discovery criteria is kept too
+	fi = exec.New(exec.Init{Pid: 44, CmdExePath: "/usr/bin/node", Service: svc.Attrs{UID: svc.UID{Name: "from-criteria"}}})
+	assert.Empty(t, Resolve(fi))
+	assert.Equal(t, "from-criteria", fi.ServiceAttrs().UID.Name)
+}
+
+func TestResolveNativeKeepsFallback(t *testing.T) {
+	mockProc(t, []string{"/ping-app"}, "/", nil)
+	fi := exec.New(exec.Init{Pid: 42, CmdExePath: "/ping-app"})
+	assert.Empty(t, Resolve(fi))
+	fi.ApplyServiceDefaults(svc.InstrumentableGolang)
+	assert.Equal(t, "ping-app", fi.ServiceAttrs().UID.Name)
+}
diff --git a/pkg/internal/procname/read_linux.go b/pkg/internal/procname/read_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..9de3a2c4e9b93c84b39d49eee132b45f9891de7e
--- /dev/null
+++ b/pkg/internal/procname/read_linux.go
@@ -0,0 +1,82 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+//go:build linux
+
+package procname // import "go.opentelemetry.io/obi/pkg/internal/procname"
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+// readInRoot reads the absolute path p inside root (/proc/<pid>/root). openat2
+// with RESOLVE_IN_ROOT resolves every symlink relative to root, so a file in a
+// container can never point OBI at a host file. Kernels without openat2 (<5.6)
+// fall back to rejecting any symlink on the path.
+func readInRoot(root, p string) ([]byte, error) {
+	if !strings.HasPrefix(p, "/") {
+		return nil, fmt.Errorf("not an absolute path: %q", p)
+	}
+	dirfd, err := unix.Open(root, unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer unix.Close(dirfd)
+
+	fd, err := unix.Openat2(dirfd, strings.TrimPrefix(p, "/"), &unix.OpenHow{
+		Flags:   unix.O_RDONLY | unix.O_CLOEXEC | unix.O_NOFOLLOW,
+		Resolve: unix.RESOLVE_IN_ROOT | unix.RESOLVE_NO_MAGICLINKS,
+	})
+	if errors.Is(err, unix.ENOSYS) {
+		fd, err = openNoSymlinks(dirfd, p)
+	}
+	if err != nil {
+		return nil, err
+	}
+	f := os.NewFile(uintptr(fd), p)
+	defer f.Close()
+	st, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if !st.Mode().IsRegular() || st.Size() > maxFileBytes {
+		return nil, fmt.Errorf("not a regular file or too large: %q", p)
+	}
+	return io.ReadAll(io.LimitReader(f, maxFileBytes+1))
+}
+
+// openNoSymlinks opens p below dirfd one component at a time with O_NOFOLLOW,
+// so any symlink (or "..") on the path makes it fail.
+func openNoSymlinks(dirfd int, p string) (int, error) {
+	parts := strings.Split(strings.Trim(p, "/"), "/")
+	cur := dirfd
+	for i, part := range parts {
+		if part == "" || part == "." || part == ".." {
+			if cur != dirfd {
+				unix.Close(cur)
+			}
+			return -1, fmt.Errorf("invalid path %q", p)
+		}
+		flags := unix.O_NOFOLLOW | unix.O_CLOEXEC
+		if i < len(parts)-1 {
+			flags |= unix.O_PATH | unix.O_DIRECTORY
+		} else {
+			flags |= unix.O_RDONLY
+		}
+		next, err := unix.Openat(cur, part, flags, 0)
+		if cur != dirfd {
+			unix.Close(cur)
+		}
+		if err != nil {
+			return -1, err
+		}
+		cur = next
+	}
+	return cur, nil
+}
diff --git a/pkg/internal/procname/read_linux_test.go b/pkg/internal/procname/read_linux_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..8fddc447058cc7ad2f6425b7103c6ae7640db98b
--- /dev/null
+++ b/pkg/internal/procname/read_linux_test.go
@@ -0,0 +1,36 @@
+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+//go:build linux
+
+package procname
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestReadInRootStaysInRoot(t *testing.T) {
+	root := t.TempDir()
+	outside := filepath.Join(t.TempDir(), "package.json")
+	require.NoError(t, os.WriteFile(outside, []byte(`{"name":"host-file"}`), 0o644))
+	require.NoError(t, os.MkdirAll(filepath.Join(root, "srv"), 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "srv", "package.json"), []byte(`{"name":"in-root"}`), 0o644))
+	// an absolute symlink inside the root must not reach the host file
+	require.NoError(t, os.Symlink(outside, filepath.Join(root, "escape.json")))
+
+	data, err := readInRoot(root, "/srv/package.json")
+	require.NoError(t, err)
+	assert.JSONEq(t, `{"name":"in-root"}`, string(data))
+
+	data, err = readInRoot(root, "/escape.json")
+	if err == nil {
+		assert.NotContains(t, string(data), "host-file")
+	}
+	_, err = readInRoot(root, "/srv/../../"+filepath.Base(filepath.Dir(outside))+"/package.json")
+	assert.Error(t, err)
+}
