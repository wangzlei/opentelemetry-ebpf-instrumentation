# ping demo, us-west-2 (account 868155213681). Sourced by lib.sh (bash). Existing resources are
# referenced by id; resources the deploy scripts create are looked up by name/tag (idempotent).
ACCOUNT=868155213681
PROFILE=ping                      # AWS_PROFILE (unset it to use ada env creds instead)
TAG_KEY=purpose TAG_VAL=ping-demo # every host / created resource; hosts also carry ping-role=<role>
PFX=ping
VPC_ID=vpc-017c34776120b35bc      # CDK Ec2DemoNetwork/DemoVpc (shared with other demos)
VPC_CIDR=10.0.0.0/8               # SG ingress source (same as ping-demo-sg)
APP_SG=sg-0f6caf64203f751e2       # ping-demo-sg: tcp 8000 from 10.0.0.0/8
INSTANCE_PROFILE=Ec2DemoObservability-ObsInstanceInstanceProfileB519BAE0-k5FB22OnWKgd
AMI_ID=ami-0b787142aa56d54db      # same AMI as the existing ping hosts
ITYPE=t3.medium
ZONE=ping.internal                # host records (audit, checkout, inventory)
ZONE_ID=Z097757611V01PJRE00N6
# Shared internal ALB (payment + inventory), subnets in >= 2 AZs
ALB_SUBNETS="subnet-021e38e8d9ca3548a subnet-04ed7b4596cd7e459 subnet-048815f90d9293828"
# Hosts the scripts may CREATE: name:subnet:role (existing hosts are found by Name/ping-role tag).
# inventory x3 in 3 subnets of us-west-2a (aws.subnet.id slicing, like us-east-1).
NEW_HOSTS="inventory-2:subnet-021e38e8d9ca3548a:inventory inventory-3:subnet-0498a89e68700c962:inventory"
# Omni bridge: OTLP/HTTP receiver of the Omni bridge host. Empty = no bridge export (us-west-2).
OMNI_BRIDGE_ENDPOINT=${OMNI_BRIDGE_ENDPOINT-}
PKG_ARN=arn:aws:ssm:us-west-2:292779133546:document/ADOT-CloudWatchAgent-eBPF-Beta
ALB_SG=""                         # "" = create ping-backend-alb-sg (tcp 8000 from VPC_CIDR)
ECR_REGION=us-west-2
