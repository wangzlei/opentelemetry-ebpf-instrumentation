# ping demo, us-east-1 (account 868155213681) -- the Omni RCA rig. NOT yet run with these scripts:
# values below were read from the live rig on 2026-10-13; re-check before the first run.
ACCOUNT=868155213681
PROFILE=ping
TAG_KEY=purpose TAG_VAL=ping-demo
PFX=ping
VPC_ID=vpc-07c52a0553fbdc225
VPC_CIDR=10.20.0.0/16
APP_SG=sg-07d764f2aecc413f2
INSTANCE_PROFILE=Ec2DemoObservability-ObsInstanceInstanceProfileB519BAE0-k5FB22OnWKgd
AMI_ID=ami-025b6f0b1ac2ef9f7
ITYPE=t3.small
ZONE=ping.us-east-1.internal
ZONE_ID=Z10203822FJ2SVERPYUUE
# An ALB needs subnets in >= 2 AZs; every subnet of this VPC is in us-east-1a today -> create one
# us-east-1b subnet (e.g. 10.20.5.0/24, NAT route table like the others) and put it here (TODO).
ALB_SUBNETS="subnet-09b9ab8f7f48cf048 TODO-subnet-us-east-1b"
# The app SG admits tcp 8000/4318 only from itself: put the ALB in the same SG.
ALB_SG=$APP_SG
NEW_HOSTS=""                      # inventory x3 already exists (3 subnets of us-east-1a)
# omni-ping-bridge i-0361a1703043e9932 (10.20.1.194), OTLP/HTTP :4318
OMNI_BRIDGE_ENDPOINT=${OMNI_BRIDGE_ENDPOINT-http://10.20.1.194:4318}
# Distributor documents are regional: the package does NOT exist in us-east-1 yet (2026-10-13).
# TODO: publish it in 292779133546/us-east-1 (adot-obi/distributor/publish.sh) and share with
# 868155213681, or publish it in 868155213681 and set PKG_ARN=ADOT-CloudWatchAgent-eBPF-Beta.
PKG_ARN=arn:aws:ssm:us-east-1:292779133546:document/ADOT-CloudWatchAgent-eBPF-Beta
# ping-demo-apps exists only in us-west-2 ECR; the hosts pull cross-region through the NAT.
ECR_REGION=us-west-2
